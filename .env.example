# Local Docker Compose values only. Copy to .env and replace both passwords.
# Generate URL-safe passwords with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=replace_with_a_local_url_safe_password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_another_local_password
MLFLOW_TRACKING_URI=http://mlflow:5000
